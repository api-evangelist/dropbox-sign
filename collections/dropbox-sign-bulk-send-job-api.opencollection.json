    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Bulk Send Job",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a bulk send job",
