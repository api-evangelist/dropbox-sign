              }
            ]
          },
          "docs": "Get a bulk send job"
        },
        {
          "info": {
            "name": "List bulk send jobs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.hellosign.com/v3/bulk_send_job/list"
          },
          "docs": "List bulk send jobs"
        }
      ]
    }
  ],
  "bundled": true
